{
  "name": "@qungtai/discord-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.qungtai/discord-mcp",
  "description": "A community MCP server for the Discord REST API with traceable coverage",
  "license": "MIT",
  "author": "Tai Q Le (Peter) (https://github.com/qungtai)",
  "repository": {
    "type": "git",
    "url": "https://github.com/qungtai/discord-mcp.git"
  },
  "homepage": "https://github.com/qungtai/discord-mcp#readme",
  "bugs": {
    "url": "https://github.com/qungtai/discord-mcp/issues"
  },
  "keywords": [
    "discord",
    "mcp",
    "model-context-protocol",
    "discord-bot",
    "ai",
    "llm"
  ],
  "type": "module",
  "bin": {
    "discord-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --coverage",
    "coverage:import": "node scripts/coverage/import-baseline.mjs",
    "coverage:sync": "node scripts/coverage/sync.mjs",
    "coverage:report": "node scripts/coverage/report.mjs",
    "coverage:check": "node scripts/coverage/check.mjs",
    "tools:manifest": "node dist/tools-manifest.js",
    "docs:tools": "node scripts/docs/generate-tools.mjs"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "discord-api-types": "^0.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "!dist/tools-manifest.js"
  ]
}
